#
# $PARU_CONF
# /etc/paru.conf
# ~/.config/paru/paru.conf
#
# See the paru.conf(5) manpage for options

#
# GENERAL OPTIONS
#
[options]
PgpFetch
Devel
Provides
DevelSuffixes = -git -cvs -svn -bzr -darcs -always -hg -fossil
#AurOnly
BottomUp
#RemoveMake
#SudoLoop
#UseAsk
#SaveChanges
#CombinedUpgrade
#CleanAfter
#UpgradeMenu
#NewsOnUpgrade

#LocalRepo
#Chroot
#Sign
#SignDb
#KeepRepoCache

#
# Binary OPTIONS
#
#[bin]
#FileManager = vifm
#MFlags = --skippgpcheck
#Sudo = doas

# Local patched AUR packages managed by `aur-overlay`.
# Path repos skip paru's review step; `aur-overlay sync` regenerates PKGBUILDs
# from the current AUR origin so `paru -Syu` sees version bumps.
[aur-overlay]
Path = {{ .chezmoi.homeDir }}/.local/share/aur-overlay/pkgbuilds
Depth = 2
GenerateSrcinfo

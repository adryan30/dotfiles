// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// Ultrawide is primary, anchored top-left.
output "DP-1" {
    position x=0 y=0
}

// Ultrawide sits bottom-left; TV sits top-right — its bottom-left corner
// meets the ultrawide's top-right corner.
//
// VRR on-demand: only turns on while a window matching the
// variable-refresh-rate rule (gamescope — see rules.kdl) is on this output,
// so normal TV use (video, desktop) never sees a VRR-related flicker.
output "HDMI-A-1" {
    // EDID preferred mode is 4K60. 4K120 is the highest rate this port
    // advertises (55C6K, HDMI 2.1). VRR on-demand still only engages for
    // gamescope, and it cannot go above this mode.
    mode "3840x2160@120.000"
    position x=3440 y=-2160
    variable-refresh-rate on-demand=true
}

// ────────────── Output Configuration ──────────────
// You can run `niri msg outputs` to get the correct name for your displays.
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// Ultrawide is primary, anchored top-left.
output "DP-1" {
    position x=0 y=0
}

// TV sits to the right of the ultrawide, bottom-aligned: its bottom-left
// corner meets the ultrawide's bottom-right corner, so it rises above the
// ultrawide's top edge.
output "HDMI-A-1" {
    position x=3440 y=-720
}
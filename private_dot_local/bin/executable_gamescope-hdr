#!/usr/bin/env bash
# Run a command inside a standalone gamescope DRM session with HDR enabled.
# gamescope takes DRM master directly, pausing the current compositor until it exits.
#
# Also flips audio to the TV for the duration: touching the marker file makes
# pw-audio-autoswitch prefer the TV HDMI sink over the monitor's while this
# script is running (the Edifier headset still wins over either, cable or
# Bluetooth — see pw-audio-autoswitch).
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "usage: gamescope-hdr <command> [args...]" >&2
    exit 1
fi

marker="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gamescope-active"
autoswitch="${HOME}/.local/bin/pw-audio-autoswitch"

nudge_audio() {
    if [[ -x "$autoswitch" ]]; then
        "$autoswitch" once || true
    fi
}

cleanup() {
    rm -f "$marker"
    nudge_audio
}
trap cleanup EXIT

touch "$marker"
nudge_audio

gamescope --backend drm --hdr-enabled -- "$@"

#!/usr/bin/env bash
# Overlay an AUR package with local patches under a new pkgname.
# Regenerates the PKGBUILD from the latest AUR origin on sync so paru -Syu
# picks up upstream version bumps.
set -euo pipefail

readonly DATA="${XDG_DATA_HOME:-$HOME/.local/share}/aur-overlay"
readonly OVERLAYS="$DATA/overlays"
readonly CACHE="$DATA/cache"
readonly PKGBUILDS="$DATA/pkgbuilds"
readonly PARU_CONF="${PARU_CONF:-$HOME/.config/paru/paru.conf}"
readonly AUR_RPC="https://aur.archlinux.org/rpc/v5"
readonly AUR_GIT="https://aur.archlinux.org"

YES=0
NOTIFY=0
DO_INSTALL=""
ALONGSIDE=0

die() { printf 'aur-overlay: %s\n' "$*" >&2; exit 1; }
log() { printf 'aur-overlay: %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'EOF'
Usage:
  aur-overlay add [ORIGIN [NAME] [PATCH...]] [--from ORIGIN] [--name NEW] [--patch FILE]...
                 [--alongside] [--install|--no-install]
  aur-overlay sync [--yes] [--notify]
  aur-overlay list
  aur-overlay diff [NAME]
  aur-overlay show NAME
  aur-overlay rm NAME [--yes]

Add clones an AUR PKGBUILD, copies your patch(es), and publishes a renamed
package into paru's [aur-overlay] PKGBUILD repo. By default it
provides/conflicts/replaces the origin. --alongside keeps the origin installed
and installs the overlay next to it (only works if files do not overlap).
Sync re-fetches each origin so the custom package tracks AUR updates.
EOF
}

need_cmds() {
  local c
  for c in git curl jq makepkg; do
    have "$c" || die "missing command: $c"
  done
}

ensure_dirs() {
  mkdir -p "$OVERLAYS" "$CACHE" "$PKGBUILDS"
}

require_paru_repo() {
  [[ -f "$PARU_CONF" ]] || die "paru.conf not found at $PARU_CONF"
  grep -q '^\[aur-overlay\]' "$PARU_CONF" \
    || die "paru.conf has no [aur-overlay] repo; apply dotfiles (chezmoi apply) first"
}

valid_pkgname() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9@._+-]*$ ]]
}

aur_info_json() {
  curl -fsSL --get "$AUR_RPC/info" --data-urlencode "arg[]=$1"
}

aur_exists() {
  local n
  n="$(aur_info_json "$1" | jq -r '.resultcount')"
  [[ "$n" -gt 0 ]]
}

aur_package_base() {
  aur_info_json "$1" | jq -r '.results[0].PackageBase // empty'
}

aur_search_pick() {
  local query="$1" pick
  have fzf || die "package '$query' not on the AUR (install fzf to search)"
  local json
  local enc
  enc="$(jq -nr --arg q "$query" '$q | @uri')"
  json="$(curl -fsSL "$AUR_RPC/search/${enc}?by=name-desc")"
  if [[ "$(jq -r '.resultcount' <<<"$json")" -eq 0 ]]; then
    die "no AUR search results for: $query"
  fi
  pick="$(
    jq -r '.results[] | "\(.Name)\t\(.Version)\t\(.Description // "")"' <<<"$json" \
      | fzf --prompt="AUR package> " --with-nth=1,2,3 --delimiter=$'\t' \
      | cut -f1
  )"
  [[ -n "$pick" ]] || die "cancelled"
  printf '%s\n' "$pick"
}

prompt() {
  local var="$1" msg="$2" default="${3:-}"
  local value=""
  if [[ -n "$default" ]]; then
    read -r -e -p "$msg [$default]: " value || true
    value="${value:-$default}"
  else
    read -r -e -p "$msg: " value || true
  fi
  printf -v "$var" '%s' "$value"
}

confirm() {
  local msg="$1" reply=""
  [[ "$YES" -eq 1 ]] && return 0
  read -r -p "$msg [y/N] " reply || true
  [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
}

is_split_pkgbuild() {
  local f="$1"
  grep -qE '^package_[a-zA-Z0-9@._+-]+[[:space:]]*\(' "$f" && return 0
  awk '
    BEGIN { inpkg=0; text="" }
    /^pkgname=\(/ { inpkg=1 }
    inpkg { text = text $0 " " }
    inpkg && /\)/ { inpkg=0 }
    END {
      gsub(/pkgname=\(/, "", text)
      gsub(/\)/, "", text)
      gsub(/['\''"]/, "", text)
      n = split(text, a, /[[:space:]]+/)
      c = 0
      for (i = 1; i <= n; i++) if (a[i] != "") c++
      if (c > 1) exit 0
      exit 1
    }
  ' "$f"
}

clone_origin() {
  local origin="$1" base="$2"
  local dest="$CACHE/$origin"
  local url="$AUR_GIT/${base}.git"
  if [[ -d "$dest/.git" ]]; then
    git -C "$dest" fetch --quiet --depth 1 origin
    git -C "$dest" reset --quiet --hard FETCH_HEAD
  else
    rm -rf "$dest"
    git clone --quiet --depth 1 "$url" "$dest"
  fi
}

footer_body() {
  local origin="$1" newname="$2" alongside="$3"
  shift 3
  cat <<EOF

# --- aur-overlay ---
# Generated by aur-overlay; edit overlays in $OVERLAYS/$newname
_overlay_origin=$(printf '%q' "$origin")
pkgbase=$(printf '%q' "$newname")
pkgname=$(printf '%q' "$newname")
_overlay_alongside=$(printf '%q' "$alongside")
_overlay_patches=(
EOF
  local p
  for p in "$@"; do
    printf '  %q\n' "$p"
  done
  cat <<'EOF'
)

if [[ "$_overlay_alongside" == 1 ]]; then
  backup=("${backup[@]//$_overlay_origin/${pkgname}}")
  _overlay_rewrite_fns=(prepare check pkgver)
else
  if declare -F pkgver >/dev/null; then
    provides+=("$_overlay_origin")
  else
    if [[ -n "${epoch:-}" ]]; then
      provides+=("${_overlay_origin}=${epoch}:${pkgver}")
    else
      provides+=("${_overlay_origin}=${pkgver}")
    fi
  fi
  conflicts+=("$_overlay_origin")
  replaces+=("$_overlay_origin")
  _overlay_rewrite_fns=(prepare build check package pkgver)
fi

_overlay_startdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for _overlay_p in "${_overlay_patches[@]}"; do
  source+=("$_overlay_p")
  _overlay_file="${startdir:-$_overlay_startdir}/$_overlay_p"
  if declare -p b2sums >/dev/null 2>&1; then
    b2sums+=("$(b2sum "$_overlay_file" | awk '{print $1}')")
  elif declare -p sha256sums >/dev/null 2>&1; then
    sha256sums+=("$(sha256sum "$_overlay_file" | awk '{print $1}')")
  elif declare -p sha512sums >/dev/null 2>&1; then
    sha512sums+=("$(sha512sum "$_overlay_file" | awk '{print $1}')")
  elif declare -p sha1sums >/dev/null 2>&1; then
    sha1sums+=("$(sha1sum "$_overlay_file" | awk '{print $1}')")
  elif declare -p md5sums >/dev/null 2>&1; then
    md5sums+=("$(md5sum "$_overlay_file" | awk '{print $1}')")
  else
    sha256sums+=("$(sha256sum "$_overlay_file" | awk '{print $1}')")
  fi
done
unset _overlay_p _overlay_file _overlay_startdir

_overlay_rewrite_pkgname_refs() {
  local _fn _body
  for _fn in "${_overlay_rewrite_fns[@]}"; do
    declare -F "$_fn" >/dev/null || continue
    _body="$(declare -f "$_fn" | sed -e 's/\${pkgname}/${_overlay_origin}/g' -e 's/\$pkgname/$_overlay_origin/g')"
    eval "$_body"
  done
}
_overlay_rewrite_pkgname_refs

_overlay_apply_patches() {
  local _p _target _d
  _target=""
  for _d in \
    "${srcdir}/${_overlay_origin}-${pkgver}" \
    "${srcdir}/${_overlay_origin}" \
    "${PWD}"; do
    if [[ -d "$_d" ]]; then
      _target="$_d"
      break
    fi
  done
  [[ -n "$_target" ]] || _target="${srcdir}"
  for _p in "${_overlay_patches[@]}"; do
    echo "aur-overlay: patch $_p -> $_target"
    patch -d "$_target" -Np1 --forward --reject-file=- -i "${srcdir}/${_p}"
  done
}

if declare -F prepare >/dev/null; then
  eval "$(declare -f prepare | sed '1s/^prepare/_overlay_orig_prepare/')"
  prepare() {
    _overlay_orig_prepare
    _overlay_apply_patches
  }
else
  prepare() {
    _overlay_apply_patches
  }
fi
EOF
}

generate_one() {
  local name="$1"
  local odir="$OVERLAYS/$name"
  local origin dest
  [[ -f "$odir/origin" ]] || die "no overlay named $name"
  origin="$(<"$odir/origin")"
  local base
  base="$(aur_package_base "$origin")"
  [[ -n "$base" ]] || die "AUR package disappeared: $origin"

  clone_origin "$origin" "$base"

  local srcpkg="$CACHE/$origin/PKGBUILD"
  [[ -f "$srcpkg" ]] || die "no PKGBUILD in AUR clone for $origin"
  if is_split_pkgbuild "$srcpkg"; then
    die "$origin is a split package; aur-overlay does not support those yet"
  fi

  dest="$PKGBUILDS/$name"
  rm -rf "$dest"
  mkdir -p "$dest"
  cp -a "$CACHE/$origin/." "$dest/"
  rm -rf "$dest/.git"

  local patches=() patch
  shopt -s nullglob
  for patch in "$odir/patches/"*; do
    local basep
    basep="$(basename "$patch")"
    cp -a "$patch" "$dest/$basep"
    patches+=("$basep")
  done
  shopt -u nullglob
  [[ ${#patches[@]} -gt 0 ]] || die "$name has no patches"

  local alongside=0
  [[ -f "$odir/alongside" ]] && alongside=1

  footer_body "$origin" "$name" "$alongside" "${patches[@]}" >>"$dest/PKGBUILD"

  (
    cd "$dest"
    makepkg --printsrcinfo >.SRCINFO
  )

  local ver
  ver="$(awk '/^[[:space:]]*pkgver = / { print $3; exit }' "$dest/.SRCINFO")"
  printf '%s\n' "$ver" >"$odir/pkgver"
  printf '%s\n' "$ver"
}

notify() {
  local summary="$1" body="${2:-}"
  [[ "$NOTIFY" -eq 1 ]] || return 0
  have notify-send || return 0
  notify-send --app-name=aur-overlay --icon=package-x-generic "$summary" "$body"
}

cmd_add() {
  local origin="" name="" patches=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --from)
        origin="${2:?}"
        shift 2
        ;;
      --name)
        name="${2:?}"
        shift 2
        ;;
      --patch)
        patches+=("${2:?}")
        shift 2
        ;;
      --alongside) ALONGSIDE=1; shift ;;
      --install) DO_INSTALL=1; shift ;;
      --no-install) DO_INSTALL=0; shift ;;
      --yes) YES=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) die "unknown argument: $1" ;;
      *)
        if [[ -z "$origin" ]]; then
          origin="$1"
        elif [[ -z "$name" ]]; then
          name="$1"
        else
          patches+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$origin" ]]; then
    prompt origin "AUR package"
    [[ -n "$origin" ]] || die "AUR package is required"
  fi
  if ! aur_exists "$origin"; then
    log "'$origin' is not an exact AUR name; searching..."
    origin="$(aur_search_pick "$origin")"
  fi
  valid_pkgname "$origin" || die "invalid origin name: $origin"

  if [[ -z "$name" ]]; then
    prompt name "New package name" "${origin}-patched"
  fi
  valid_pkgname "$name" || die "invalid package name: $name"
  [[ "$name" != "$origin" ]] || die "new name must differ from the AUR package"

  if aur_exists "$name"; then
    log "warning: '$name' already exists on the AUR; the local overlay will take priority"
  fi

  if [[ ${#patches[@]} -eq 0 ]]; then
    local p=""
    prompt p "Patch file"
    [[ -n "$p" ]] || die "at least one --patch is required"
    patches+=("$p")
  fi

  local resolved=() patch abs
  for patch in "${patches[@]}"; do
    abs="$(readlink -f "$patch")" || die "patch not found: $patch"
    [[ -f "$abs" ]] || die "patch not found: $patch"
    [[ -s "$abs" ]] || die "patch is empty: $patch"
    resolved+=("$abs")
  done

  if [[ -d "$OVERLAYS/$name" && "$YES" -ne 1 ]]; then
    confirm "Overlay '$name' exists; replace it?" || die "cancelled"
  fi

  local odir="$OVERLAYS/$name"
  rm -rf "$odir"
  mkdir -p "$odir/patches"
  printf '%s\n' "$origin" >"$odir/origin"
  [[ "$ALONGSIDE" == 1 ]] && : >"$odir/alongside"
  local i=0
  for abs in "${resolved[@]}"; do
    i=$((i + 1))
    local dest
    dest="$(printf '%04d-%s' "$i" "$(basename "$abs")")"
    cp -a "$abs" "$odir/patches/$dest"
  done

  log "generating $name from $origin..."
  local ver
  ver="$(generate_one "$name")"
  log "ready: $name $ver  (origin $origin)"
  log "PKGBUILD at $PKGBUILDS/$name"

  if [[ -z "$DO_INSTALL" ]]; then
    if [[ -t 0 ]]; then
      confirm "Install $name with paru now?" && DO_INSTALL=1 || DO_INSTALL=0
    else
      DO_INSTALL=0
    fi
  fi
  if [[ "$DO_INSTALL" == 1 ]]; then
    have paru || die "paru not found"
    paru -S -- "$name"
  else
    log "install later with: paru -S $name"
  fi
}

cmd_sync() {
  local name updated=() failed=() ver old
  shopt -s nullglob
  local dirs=("$OVERLAYS"/*)
  shopt -u nullglob
  [[ ${#dirs[@]} -gt 0 ]] || { log "no overlays"; return 0; }

  for dir in "${dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    old=""
    [[ -f "$dir/pkgver" ]] && old="$(<"$dir/pkgver")"
    log "sync $name..."
    if ver="$(generate_one "$name")"; then
      if [[ -n "$old" && "$old" != "$ver" ]]; then
        updated+=("$name $old -> $ver")
        log "$name: $old -> $ver"
      else
        log "$name: $ver"
      fi
    else
      failed+=("$name")
      log "FAILED $name"
    fi
  done

  if [[ ${#updated[@]} -gt 0 ]]; then
    local body
    body="$(printf '%s\n' "${updated[@]}")"
    notify "AUR overlay updates" "$body"$'\n'"Install with: paru -Syu"
    log "version bumps:"
    printf '  %s\n' "${updated[@]}"
  fi
  if [[ ${#failed[@]} -gt 0 ]]; then
    notify "AUR overlay sync failed" "$(printf '%s\n' "${failed[@]}")"
    die "failed: ${failed[*]}"
  fi
}

cmd_list() {
  shopt -s nullglob
  local dir name origin ver
  printf '%-24s %-24s %s\n' "PACKAGE" "ORIGIN" "VERSION"
  for dir in "$OVERLAYS"/*; do
    [[ -d "$dir" ]] || continue
    name="$(basename "$dir")"
    origin="$(<"$dir/origin")"
    ver="$(cat "$dir/pkgver" 2>/dev/null || echo '?')"
    printf '%-24s %-24s %s\n' "$name" "$origin" "$ver"
  done
  shopt -u nullglob
}

cmd_show() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: aur-overlay show NAME"
  local odir="$OVERLAYS/$name"
  [[ -d "$odir" ]] || die "no overlay named $name"
  echo "name:    $name"
  echo "origin:  $(<"$odir/origin")"
  echo "version: $(cat "$odir/pkgver" 2>/dev/null || echo '?')"
  if [[ -f "$odir/alongside" ]]; then
    echo "mode:    alongside (keeps origin installed)"
  else
    echo "mode:    replaces origin"
  fi
  echo "patches:"
  local p
  for p in "$odir/patches/"*; do
    echo "  $(basename "$p")"
  done
  echo "pkgbuild: $PKGBUILDS/$name/PKGBUILD"
}

cmd_diff() {
  local names=() name
  if [[ -n "${1:-}" ]]; then
    names=("$1")
  else
    shopt -s nullglob
    local dir
    for dir in "$OVERLAYS"/*; do
      [[ -d "$dir" ]] && names+=("$(basename "$dir")")
    done
    shopt -u nullglob
  fi
  [[ ${#names[@]} -gt 0 ]] || die "no overlays"
  for name in "${names[@]}"; do
    local origin dest srcpkg
    origin="$(<"$OVERLAYS/$name/origin")"
    srcpkg="$CACHE/$origin/PKGBUILD"
    dest="$PKGBUILDS/$name/PKGBUILD"
    [[ -f "$srcpkg" ]] || { log "no cached origin for $name; run sync"; continue; }
    echo "==> $name (origin $origin PKGBUILD)"
    git --no-pager diff --no-index -- "$srcpkg" "$dest" || true
  done
}

cmd_rm() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: aur-overlay rm NAME"
  [[ -d "$OVERLAYS/$name" ]] || die "no overlay named $name"
  confirm "Remove overlay $name?" || die "cancelled"
  rm -rf "$OVERLAYS/$name" "$PKGBUILDS/$name"
  log "removed $name"
  log "if installed: paru -Rns $name"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    -h|--help|help|"") usage; return 0 ;;
  esac
  need_cmds
  ensure_dirs
  require_paru_repo

  shift || true
  case "$cmd" in
    add) cmd_add "$@" ;;
    sync)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --yes) YES=1; shift ;;
          --notify) NOTIFY=1; shift ;;
          -h|--help) usage; exit 0 ;;
          *) die "unknown argument: $1" ;;
        esac
      done
      cmd_sync
      ;;
    list) cmd_list ;;
    show) cmd_show "$@" ;;
    diff) cmd_diff "$@" ;;
    rm|remove)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --yes) YES=1; shift ;;
          -h|--help) usage; exit 0 ;;
          *) break ;;
        esac
      done
      cmd_rm "$@"
      ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $cmd (try --help)" ;;
  esac
}

main "$@"

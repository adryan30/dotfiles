#!/usr/bin/env python3
"""
Dynamic niri window handling that static window-rules can't express.

- Zen/Firefox Bitwarden (and other extension) popups open with a generic
  title, so niri's open-floating window-rules never match. This watches the
  event stream and floats + PiP-places them in the top-right once the real
  title lands. Based on: https://github.com/niri-wm/niri/discussions/1599
- niri window-rules can't match on environment variables at all. Windows
  whose process has GAME=1 set (games launched through a wrapper that sets
  it) get moved to workspace 2 on their own output, once.
"""

from __future__ import annotations

from dataclasses import dataclass, field
import json
import logging
import os
from pathlib import Path
import re
from socket import AF_UNIX, SHUT_WR, socket
import subprocess
import sys
from time import sleep

# PiP-ish size for Bitwarden passkey / unlock popups
POPUP_WIDTH = 420
POPUP_HEIGHT = 560
MARGIN = 32

# Workspace index (per-output) that GAME=1 windows get routed to.
GAME_WORKSPACE = 2


@dataclass(kw_only=True)
class Match:
    title: str | None = None
    app_id: str | None = None

    def matches(self, window: dict) -> bool:
        if self.title is None and self.app_id is None:
            return False

        ok = True
        if self.title is not None:
            ok &= re.search(self.title, window.get("title") or "") is not None
        if self.app_id is not None:
            ok &= re.search(self.app_id, window.get("app_id") or "") is not None
        return ok


@dataclass
class Rule:
    match: list[Match] = field(default_factory=list)
    exclude: list[Match] = field(default_factory=list)
    width: int = POPUP_WIDTH
    height: int = POPUP_HEIGHT

    def matches(self, window: dict) -> bool:
        if self.match and not any(m.matches(window) for m in self.match):
            return False
        if any(m.matches(window) for m in self.exclude):
            return False
        return True


# One Rule() ≈ one window-rule {}. Title is set late — that's why we need this.
RULES = [
    Rule(
        match=[
            Match(
                app_id=r"^(zen|firefox|org\.mozilla\.firefox|librewolf)$",
                title=r"Extension:.*Bitwarden",
            )
        ],
        width=420,
        height=560,
    ),
    # Other Zen/Firefox extension popups (same late-title problem)
    Rule(
        match=[
            Match(
                app_id=r"^(zen|firefox|org\.mozilla\.firefox|librewolf)$",
                title=r"^Extension:",
            )
        ],
        width=380,
        height=520,
    ),
]

LOG = Path.home() / ".local/state/niri-dynamic-float.log"
LOG.parent.mkdir(parents=True, exist_ok=True)
logging.basicConfig(
    filename=LOG,
    encoding="utf-8",
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger("niri-dynamic-float")


def send(request: dict) -> None:
    with socket(AF_UNIX) as sock:
        sock.connect(os.environ["NIRI_SOCKET"])
        f = sock.makefile("rw")
        f.write(json.dumps(request))
        f.flush()


def focused_output_size() -> tuple[int, int]:
    """Logical size of the focused output (fallback 2560x1440)."""
    try:
        raw = subprocess.check_output(
            ["niri", "msg", "-j", "focused-output"],
            text=True,
            timeout=2,
        )
        data = json.loads(raw)
        logical = data.get("logical") or {}
        w = int(logical.get("width") or 0)
        h = int(logical.get("height") or 0)
        if w > 0 and h > 0:
            return w, h
    except Exception as err:
        log.warning("focused-output query failed: %s", err)
    return 2560, 1440


def float_pip(window_id: int, width: int, height: int) -> None:
    send({"Action": {"MoveWindowToFloating": {"id": window_id}}})
    # Give niri a tick to move it to floating before resize/move
    sleep(0.05)
    send(
        {
            "Action": {
                "SetWindowWidth": {
                    "id": window_id,
                    "change": {"SetFixed": width},
                }
            }
        }
    )
    send(
        {
            "Action": {
                "SetWindowHeight": {
                    "id": window_id,
                    "change": {"SetFixed": height},
                }
            }
        }
    )
    out_w, _out_h = focused_output_size()
    x = float(max(MARGIN, out_w - width - MARGIN))
    y = float(MARGIN)
    send(
        {
            "Action": {
                "MoveFloatingWindow": {
                    "id": window_id,
                    "x": {"SetFixed": x},
                    "y": {"SetFixed": y},
                }
            }
        }
    )


GAME_ROUTED: set[int] = set()


def has_game_env(pid: int) -> bool:
    """True if pid's environment has GAME=1 (set by a game-launch wrapper)."""
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return False
    return b"GAME=1" in raw.split(b"\0")


def route_game_window(win: dict) -> None:
    win_id = win["id"]
    if win_id in GAME_ROUTED:
        return
    pid = win.get("pid")
    if pid is None or not has_game_env(pid):
        return
    GAME_ROUTED.add(win_id)
    log.info(
        "GAME=1 window id=%s app_id=%r pid=%s -> workspace %s",
        win_id,
        win.get("app_id"),
        pid,
        GAME_WORKSPACE,
    )
    send(
        {
            "Action": {
                "MoveWindowToWorkspace": {
                    "window_id": win_id,
                    "reference": {"Index": GAME_WORKSPACE},
                    "focus": False,
                }
            }
        }
    )


# Zen/Firefox picture-in-picture. niri has no sticky/always-on-top windows
# (niri-wm/niri#932), so we emulate "visible on every workspace" by moving the
# PiP to the active workspace on its own output as the user switches.
PIP = Match(
    app_id=r"^(zen|firefox|org\.mozilla\.firefox|librewolf)$",
    title=r"^Picture-in-Picture$",
)


def is_pip(win: dict) -> bool:
    return PIP.matches(win)


def follow_pip(workspace_id: int | None, pip: dict | None) -> dict | None:
    """Move the tracked PiP to the workspace that just got activated."""
    if pip is None or workspace_id is None or pip.get("ws") == workspace_id:
        return pip

    try:
        send(
            {
                "Action": {
                    "MoveWindowToWorkspace": {
                        "window_id": pip["id"],
                        "reference": {"Id": workspace_id},
                        "focus": False,
                    }
                }
            }
        )
        log.info("moved PiP id=%s to workspace %s", pip["id"], workspace_id)
        pip["ws"] = workspace_id
    except Exception as err:
        log.error("PiP follow failed: %s", err)
    return pip


def matching_rule(win: dict) -> Rule | None:
    for rule in RULES:
        if rule.matches(win):
            return rule
    return None


def update_matched(windows: dict, win: dict) -> None:
    prev = windows.get(win["id"], {})
    matched_before = bool(prev.get("matched"))
    rule = matching_rule(win)
    win["matched"] = rule is not None
    if win["matched"] and not matched_before and rule is not None:
        log.info(
            "float PiP title=%r app_id=%r id=%s",
            win.get("title"),
            win.get("app_id"),
            win["id"],
        )
        float_pip(win["id"], rule.width, rule.height)


def run_once() -> None:
    sock = socket(AF_UNIX)
    sock.connect(os.environ["NIRI_SOCKET"])
    f = sock.makefile("rw")
    f.write('"EventStream"')
    f.flush()
    sock.shutdown(SHUT_WR)

    windows: dict[int, dict] = {}
    pip: dict | None = None
    for line in f:
        event = json.loads(line)

        if changed := event.get("WindowsChanged"):
            for win in changed["windows"]:
                update_matched(windows, win)
                route_game_window(win)
                if is_pip(win):
                    pip = {"id": win["id"], "ws": win.get("workspace_id")}
            windows = {win["id"]: win for win in changed["windows"]}
        elif changed := event.get("WindowOpenedOrChanged"):
            win = changed["window"]
            update_matched(windows, win)
            route_game_window(win)
            if is_pip(win):
                pip = {"id": win["id"], "ws": win.get("workspace_id")}
            windows[win["id"]] = win
        elif changed := event.get("WorkspaceActivated"):
            pip = follow_pip(changed.get("id"), pip)
        elif changed := event.get("WindowClosed"):
            if pip is not None and pip["id"] == changed["id"]:
                pip = None
            windows.pop(changed["id"], None)
            GAME_ROUTED.discard(changed["id"])


def main() -> None:
    if "NIRI_SOCKET" not in os.environ:
        log.error("NIRI_SOCKET is not set; must run inside a niri session")
        sys.exit(1)
    if not RULES:
        log.error("RULES is empty")
        sys.exit(1)

    log.info("started")
    while True:
        try:
            run_once()
            log.warning("event stream ended; reconnecting in 2s")
            sleep(2)
        except KeyboardInterrupt:
            log.info("stopped")
            break
        except Exception as err:
            log.error("error: %s; restarting in 3s", err)
            sleep(3)


if __name__ == "__main__":
    main()

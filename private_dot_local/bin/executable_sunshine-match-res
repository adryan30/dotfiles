#!/usr/bin/env python3
"""Match niri's output to the Moonlight client for a Sunshine session.

Sunshine sets SUNSHINE_CLIENT_{WIDTH,HEIGHT,FPS} before prep-cmd. Macs often
request 1080p/1440p (or odd 16:10 sizes); the ultrawide's native 3440x1440
makes UI unreadably small when that framebuffer is scaled down on the client.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

STATE_PATH = Path.home() / ".config/sunshine/last-niri-mode.json"
FALLBACK = (1920, 1080, 60_000)


def niri_outputs() -> dict:
    return json.loads(subprocess.check_output(["niri", "msg", "-j", "outputs"]))


def active_output(outs: dict) -> tuple[str, dict]:
    for name, out in outs.items():
        if out.get("logical") is not None:
            return name, out
    raise SystemExit("sunshine-match-res: no active niri output")


def mhz_to_hz(mhz: int) -> str:
    return f"{mhz / 1000:.3f}"


def snapshot(out: dict) -> dict:
    idx = out["current_mode"]
    mode = out["modes"][idx]
    logical = out["logical"]
    return {
        "name": out["name"],
        "width": mode["width"],
        "height": mode["height"],
        "refresh_mhz": mode["refresh_rate"],
        "is_custom": bool(out.get("is_custom_mode")),
        "scale": logical["scale"],
    }


def niri_mode(name: str, width: int, height: int, mhz: int, *, custom: bool) -> subprocess.CompletedProcess:
    spec = f"{width}x{height}@{mhz_to_hz(mhz)}"
    action = "custom-mode" if custom else "mode"
    return subprocess.run(
        ["niri", "msg", "output", name, action, spec],
        capture_output=True,
        text=True,
    )


def niri_scale(name: str, scale: float | str) -> None:
    subprocess.run(
        ["niri", "msg", "output", name, "scale", str(scale)],
        check=False,
        capture_output=True,
        text=True,
    )


def pick_edid(out: dict, width: int, height: int, want_mhz: int) -> dict | None:
    matches = [m for m in out["modes"] if m["width"] == width and m["height"] == height]
    if not matches:
        return None

    def score(mode: dict) -> tuple:
        mhz = mode["refresh_rate"]
        return (abs(mhz - want_mhz), -mhz)

    return min(matches, key=score)


def fit_panel(width: int, height: int, max_w: int, max_h: int) -> tuple[int, int]:
    if width <= max_w and height <= max_h:
        return width, height
    scale = min(max_w / width, max_h / height)
    return int(width * scale) & ~1, int(height * scale) & ~1


def apply_target(name: str, out: dict, width: int, height: int, want_mhz: int) -> bool:
    edid = pick_edid(out, width, height, want_mhz)
    if edid is not None:
        result = niri_mode(name, edid["width"], edid["height"], edid["refresh_rate"], custom=False)
        if result.returncode == 0:
            print(f"sunshine-match-res: EDID {edid['width']}x{edid['height']}@{mhz_to_hz(edid['refresh_rate'])}")
            return True
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)

    result = niri_mode(name, width, height, want_mhz, custom=True)
    if result.returncode == 0:
        print(f"sunshine-match-res: custom {width}x{height}@{mhz_to_hz(want_mhz)}")
        return True
    print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
    return False


def cmd_do() -> int:
    width = int(os.environ.get("SUNSHINE_CLIENT_WIDTH", FALLBACK[0]))
    height = int(os.environ.get("SUNSHINE_CLIENT_HEIGHT", FALLBACK[1]))
    fps = float(os.environ.get("SUNSHINE_CLIENT_FPS", "60"))
    want_mhz = max(1, int(round(fps * 1000)))

    outs = niri_outputs()
    name, out = active_output(outs)
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(snapshot(out), indent=2) + "\n")

    max_w = max(m["width"] for m in out["modes"])
    max_h = max(m["height"] for m in out["modes"])
    width, height = fit_panel(width, height, max_w, max_h)

    if apply_target(name, out, width, height, want_mhz):
        niri_scale(name, 1)
        return 0

    fb_w, fb_h, fb_mhz = FALLBACK
    fb = pick_edid(out, fb_w, fb_h, fb_mhz)
    if fb is not None and niri_mode(name, fb["width"], fb["height"], fb["refresh_rate"], custom=False).returncode == 0:
        print(f"sunshine-match-res: fallback {fb_w}x{fb_h}@{mhz_to_hz(fb['refresh_rate'])}")
        niri_scale(name, 1)
        return 0

    print("sunshine-match-res: could not change mode; leaving display as-is", file=sys.stderr)
    return 0


def cmd_undo() -> int:
    if not STATE_PATH.exists():
        return 0
    state = json.loads(STATE_PATH.read_text())
    result = niri_mode(
        state["name"],
        state["width"],
        state["height"],
        state["refresh_mhz"],
        custom=bool(state.get("is_custom")),
    )
    if result.returncode != 0 and state.get("is_custom"):
        result = niri_mode(
            state["name"],
            state["width"],
            state["height"],
            state["refresh_mhz"],
            custom=False,
        )
    if result.returncode != 0:
        print(result.stderr.strip() or result.stdout.strip(), file=sys.stderr)
    niri_scale(state["name"], state.get("scale", 1))
    STATE_PATH.unlink(missing_ok=True)
    print(
        f"sunshine-match-res: restored {state['width']}x{state['height']}"
        f"@{mhz_to_hz(state['refresh_mhz'])}"
    )
    return 0


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {"do", "undo"}:
        print("usage: sunshine-match-res do|undo", file=sys.stderr)
        return 2
    try:
        return cmd_do() if sys.argv[1] == "do" else cmd_undo()
    except Exception as exc:  # noqa: BLE001 — prep-cmd must not abort the stream
        print(f"sunshine-match-res: {exc}", file=sys.stderr)
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
